[user]
	name = {{ .git.user }}
	email = {{ .git.email }}

[core]
  filemode = false
  symlinks = true
  editor = nvim

[include]
  path = ~/.gitconfig_dir/local.gitconfig

[alias]
  tree = log --graph --pretty=format:'%x09%C(auto) %h %Cgreen %ar %Creset%x09by"%C(cyan ul)%an%Creset" %x09%C(auto)%s %d'

[http]
  postBuffer = 524288000

[init]
  defaultBranch = main
