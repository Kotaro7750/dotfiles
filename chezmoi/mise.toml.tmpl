[settings.npm]
package_manager = "npm"

[tools]
# Programming Languages
"node" = "latest"
"go" = "latest"
"rust" = "latest"
"python" = "latest"

"npm:@github/copilot-language-server" = "latest"
"go:golang.org/x/tools/gopls" = "latest"
"aqua:LuaLS/lua-language-server" = "latest"
"cargo:https://github.com/rust-lang/rust-analyzer" = { version = "latest", crate = "rust-analyzer" }

# Coding Agent
"npm:@openai/codex" = "latest"
"npm:@anthropic-ai/claude-code" = { version = "latest", allow_builds = true }

# Utilities
"npm:@devcontainers/cli" = "latest"
"cargo:tree-sitter-cli" = "latest"
"aws-cli" = { "version" = "latest"}
